{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-bg.ps1",
    "dev:fg": "tsx server.ts",
    "dev:bg": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-bg.ps1",
    "dev:stop": "node scripts/dev-server.mjs stop",
    "dev:status": "node scripts/dev-server.mjs status",
    "dev:restart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-restart.ps1",
    "start": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "verify:scoring": "tsx scripts/verify-scoring.ts",
    "verify:extensive": "tsx scripts/verify-extensive.ts",
    "verify:premium": "tsx scripts/verify-premium.ts",
    "verify:stability": "tsx scripts/verify-stability.ts",
    "verify:stability:strict": "tsx scripts/verify-stability.ts --strict",
    "audit:questions": "tsx scripts/audit-questions.ts",
    "verify:catalog": "tsx scripts/verify-catalog.ts",
    "export:questions": "tsx scripts/export-question-bank.ts",
    "export:catalog": "tsx scripts/export-catalog.ts",
    "analyze:pilot": "tsx scripts/analyze-pilot.ts",
    "verify:all": "npm run lint && npm run verify:scoring && npm run verify:extensive && npm run verify:catalog && npm run verify:premium && npm run verify:stability:strict && npm run audit:questions && npm run build"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@paypal/react-paypal-js": "^9.1.1",
    "@stripe/react-stripe-js": "^6.2.0",
    "@stripe/stripe-js": "^9.2.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.1",
    "stripe": "^22.0.2",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
